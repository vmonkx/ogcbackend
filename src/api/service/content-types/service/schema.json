{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "name": "service",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "services"
    },
    "article": {
      "type": "component",
      "component": "service-components.article-service",
      "repeatable": true
    },
    "video": {
      "type": "component",
      "component": "service-components.video-section",
      "repeatable": true
    },
    "prices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::price.price",
      "mappedBy": "service"
    },
    "seo": {
      "type": "component",
      "component": "service-components.seo",
      "repeatable": false
    },
    "featured": {
      "type": "boolean"
    },
    "coverColor": {
      "type": "component",
      "component": "service-components.cover-color",
      "repeatable": false,
      "required": true
    },
    "personals": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::personal.personal",
      "mappedBy": "services"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "advancedContent": {
      "type": "dynamiczone",
      "components": [
        "service-components.advantage"
      ]
    },
    "resultSection": {
      "type": "dynamiczone",
      "components": [
        "service-components.result-item"
      ]
    },
    "compareSection": {
      "type": "dynamiczone",
      "components": [
        "service-components.compare-item"
      ]
    },
    "mobileLayout": {
      "type": "dynamiczone",
      "components": [
        "mobile-blocks.quick-facts",
        "mobile-blocks.bullet-cards",
        "mobile-blocks.timeline-block",
        "mobile-blocks.alert-block"
      ]
    }
  }
}
