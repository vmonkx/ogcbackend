# Copy this file to .env and replace all replace-with-* placeholders.
# Generate each Strapi secret independently: openssl rand -hex 32
# This template contains no real credentials. Do not commit your .env.

# Strapi server
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
APP_KEYS=replace-with-app-key-1,replace-with-app-key-2,replace-with-app-key-3,replace-with-app-key-4
ADMIN_JWT_SECRET=replace-with-admin-jwt-secret
API_TOKEN_SALT=replace-with-api-token-salt
TRANSFER_TOKEN_SALT=replace-with-transfer-token-salt
ENCRYPTION_KEY=replace-with-encryption-key
JWT_SECRET=replace-with-users-permissions-jwt-secret

# BFF used by the price synchronization button.
# Include only the base URL, without /api/v1 or a trailing slash.
# 127.0.0.1 works when Strapi and BFF run on the same machine.
# If Strapi runs in Docker, use the BFF service hostname or host.docker.internal.
BFF_API_URL=http://127.0.0.1:3057
# Must match APP_TOKEN in the BFF environment; do not use a Strapi admin token.
APP_TOKEN=replace-with-bff-app-token

# Strapi PostgreSQL connection
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=ogc_strapi
DATABASE_USERNAME=ogc_strapi
DATABASE_PASSWORD=replace-with-postgres-password
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Price synchronization holds a PostgreSQL advisory lock on one connection.
# Keep DATABASE_POOL_MAX at least 2 so document writes have another connection.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000
# Alternative to individual PostgreSQL connection fields:
# DATABASE_URL=postgresql://ogc_strapi:replace-with-postgres-password@127.0.0.1:5432/ogc_strapi
# Optional SSL values consumed only when DATABASE_SSL=true:
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=
# DATABASE_SSL_CAPATH=
# DATABASE_SSL_CIPHER=
# For local SQLite instead: DATABASE_CLIENT=sqlite (single CMS process).
# DATABASE_FILENAME=.tmp/data.db

# Local database and pgAdmin containers from docker-compose.yml.
# Keep POSTGRES_* credentials and port consistent with DATABASE_* above.
# For Strapi inside the same Docker network use DATABASE_HOST=db instead.
POSTGRES_USER=ogc_strapi
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=ogc_strapi
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-pgadmin-password
PGADMIN_PORT=5050

# Cloudinary upload provider
CLOUDINARY_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_KEY=replace-with-cloudinary-api-key
CLOUDINARY_SECRET=replace-with-cloudinary-api-secret

# Optional Telegram integration used by src/helpers/sendTelegram.js.
# The helper appends the message to this URL; retain the final text= parameter.
# TELEGRAM_API="https://api.telegram.org/bot<bot-token>/sendMessage?chat_id=<chat-id>&text="

# Optional Strapi behavior (current defaults)
WEBHOOKS_POPULATE_RELATIONS=false
FLAG_NPS=true
FLAG_PROMOTE_EE=true
FLAG_DOC_LINKS=true
